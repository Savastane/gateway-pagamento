# Copie para docker/.env e preencha. NUNCA commitar .env com valores reais.

# Postgres (os servicos montam DATABASE_URL a partir destes)
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gw

# Auth interna e da API (obrigatorios fora de dev local)
API_KEY=
INTERNAL_TOKEN=

# Gateway padrao quando o request nao informa `gateway`
DEFAULT_GATEWAY=stripe

# Stripe (sandbox: `stripe sandbox create` ou painel)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Appmax (painel sandboxappmax.com.br)
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
APPMAX_API_BASE=https://api.sandboxappmax.com.br

# Asaas (sandbox.asaas.com — chave $aact_...)
ASAAS_ACCESS_TOKEN=
ASAAS_WEBHOOK_TOKEN=

# Mercado Pago (painel de desenvolvedor — TEST-/APP_USR-)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
