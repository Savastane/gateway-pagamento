# Copie para docker/.env e preencha. NUNCA commitar .env com valores reais.

# Postgres (os servicos montam DATABASE_URL a partir destes)
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gw

# Auth interna e da API (obrigatorios fora de dev local)
API_KEY=
INTERNAL_TOKEN=

# Gateway padrao quando o request nao informa `gateway`
DEFAULT_GATEWAY=stripe

# Stripe (sandbox: `stripe sandbox create` ou painel)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Appmax (painel sandboxappmax.com.br)
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
APPMAX_API_BASE=https://api.sandboxappmax.com.br

# Asaas (sandbox.asaas.com — chave $aact_...)
ASAAS_ACCESS_TOKEN=
ASAAS_WEBHOOK_TOKEN=

# Mercado Pago (painel de desenvolvedor — TEST-/APP_USR-)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Assinaturas App Store / Google Play (compose.native-stores.yml)
# Gere 32 bytes aleatorios e codifique em base64. Nao altere a chave sem recriptografar os tokens.
STORE_TOKEN_ENCRYPTION_KEY=
# URL publica da API profissional: https://<api>/api/assinatura/lojas/notificacao
STORE_CALLBACK_URL=
STORE_CALLBACK_TOKEN=
STORE_ALLOW_SANDBOX_PURCHASES=false
GOOGLE_PLAY_PACKAGE_NAME=city.bussola.profissional
GOOGLE_PLAY_MONTHLY_PRODUCT=bussola_pro_mensal
GOOGLE_PLAY_YEARLY_PRODUCT=bussola_pro_anual
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
APPLE_BUNDLE_ID=city.bussola.profissional
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_STORE_ENVIRONMENT=Production
# App Review: fallback Sandbox somente para os UUIDs de contas profissionais listados.
APPLE_ALLOW_SANDBOX_FALLBACK=false
APPLE_SANDBOX_ACCOUNT_IDS=
APPLE_MONTHLY_PRODUCT=city.bussola.profissional.mensal
APPLE_YEARLY_PRODUCT=city.bussola.profissional.anual
